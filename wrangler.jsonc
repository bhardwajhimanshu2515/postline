{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postline",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  // nodejs_compat: needed by the MCP handler (AsyncLocalStorage).
  // global_fetch_strictly_public: outbound fetches (image downloads, client
  // metadata documents) can only reach the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Every minute: publish scheduled posts that are due.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    // Create it with: npx wrangler d1 create postline
    // then paste the database_id it prints here.
    { "binding": "DB", "database_name": "postline", "database_id": "3af413fe-68fc-4fa4-a40e-d44d7a257856", "migrations_dir": "migrations" }
  ],

  "kv_namespaces": [
    // Create it with: npx wrangler kv namespace create OAUTH_KV
    // then paste the id it prints here.
    { "binding": "OAUTH_KV", "id": "9b928035ad254f1a95d82789283929bd" }
  ],

  "vars": {
    // The exact URL people paste into Claude. Change it if you rename the
    // Worker or use a custom domain.
    "MCP_RESOURCE": "https://postline.bhardwajhimanshu2515.workers.dev/mcp",
    // LinkedIn app's Client ID (public; it appears in every sign-in link).
    "LINKEDIN_CLIENT_ID": "86i349mdtfk53l",
    "LINKEDIN_VERSION": "202608",
    "APP_NAME": "Postline By Sr Dev",
    // Shown publicly on the docs and privacy pages.
    "OPERATOR_NAME": "Himanshu Bhardwaj",
    "SUPPORT_EMAIL": "bhardwajhimanshu2515@gmail.com"
  }

  // Secrets (never put these in this file):
  //   npx wrangler secret put LINKEDIN_CLIENT_SECRET
  //   npx wrangler secret put SCHEDULE_ENCRYPTION_KEY   (32+ random characters)
}
